diff --git a/app/notifications/alert_policy.py b/app/notifications/alert_policy.py
new file mode 100644
index 0000000..46cc7c5
--- /dev/null
+++ b/app/notifications/alert_policy.py
@@ -0,0 +1,76 @@
+"""Turn fresh sensor and fixed-slot evidence into farmer-facing incidents."""
+
+import math
+
+
+SENSOR_LABELS = {
+    "ph": ("pH", "value"),
+    "ec": ("EC", "value_mScm"),
+    "water_temperature": ("Water temperature", "value_C"),
+    "turbidity": ("Turbidity", "value_ntu"),
+}
+
+
+def enrich_issues(issues, live_snapshot=None, fusion_by_slot=None):
+    """Add specific critical and plant notices without trusting retained readings."""
+    issues = dict(issues)
+    sensors = live_snapshot.get("sensors") if isinstance(live_snapshot, dict) else None
+    if isinstance(sensors, dict):
+        for name, (label, value_field) in SENSOR_LABELS.items():
+            sensor = sensors.get(name)
+            if not isinstance(sensor, dict):
+                continue
+            value = sensor.get(value_field)
+            status = str(sensor.get("status") or "")
+            if (str(sensor.get("classification") or "").upper() != "CRITICAL"
+                    or sensor.get("valid") is False or sensor.get("retained") is True
+                    or sensor.get("stale") is True or sensor.get("spike") is True
+                    or status.startswith(("ERROR", "RECOVERING", "UNAVAILABLE"))
+                    or isinstance(value, bool) or not isinstance(value, (int, float))
+                    or not math.isfinite(value)):
+                continue
+            issues[f"sensor:{name}:critical"] = {
+                "source": "sensor", "severity": "critical",
+                "message": f"{label} is critical: {value:.4f} {sensor.get('unit') or ''}. Check the water.",
+                "sensor_value": value, "sensor_unit": sensor.get("unit") or "",
+            }
+        # The per-sensor event names the actual trigger; avoid a second generic SMS.
+        if any(key.startswith("sensor:") and key.endswith(":critical")
+               for key in issues):
+            issues.pop("water_quality:classification", None)
+
+    if isinstance(fusion_by_slot, list):
+        issues.pop("vision:harvest_ready", None)
+        global_vision_fault = any(key in issues for key in
+                                  ("vision:camera", "vision:plant_model"))
+        if (not global_vision_fault and len(fusion_by_slot) == 10
+                and all(isinstance(row, dict) and row.get("plant_condition") == "Faulty Vision"
+                        for row in fusion_by_slot)):
+            global_vision_fault = True
+            issues["vision:camera"] = {
+                "source": "vision", "severity": "critical",
+                "message": "Camera or plant analysis is unavailable. Check the camera image.",
+            }
+        for row in fusion_by_slot:
+            if not isinstance(row, dict):
+                continue
+            slot = row.get("slot")
+            if type(slot) is not int or not 1 <= slot <= 10:
+                continue
+            condition = row.get("plant_condition")
+            if condition == "Harvest-Ready" and row.get("status") == "READY":
+                issues[f"vision:slot:{slot}:harvest_ready"] = {
+                    "source": "vision", "severity": "notice",
+                    "message": f"Plant {slot} is now Harvest-Ready. Check its planting date and harvest schedule.",
+                }
+            elif condition == "Faulty Vision" and not global_vision_fault:
+                issues[f"vision:slot:{slot}:fault"] = {
+                    "source": "vision", "severity": "critical",
+                    "message": f"Plant {slot} could not be classified by the camera. Check the image and camera.",
+                }
+    elif "vision:harvest_ready" in issues:
+        issues["vision:harvest_ready"] = {
+            "source": "vision", "severity": "notice",
+            "message": "Harvest-Ready lettuce detected. Check the plant positions and planting dates.",
+        }
+    return issues
