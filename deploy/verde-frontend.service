[Unit]
Description=VERDE frontend and backend API proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=verde
WorkingDirectory=/home/verde/VERDEapp
ExecStart=/usr/bin/python3 /home/verde/VERDEapp/deploy/verde-frontend-proxy.py --port 8000 --backend http://127.0.0.1:8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
