+    elif issue_key.startswith("sensor:") and issue_key.endswith(":critical"):
+        name = issue_key.split(":", 2)[1]
+        sensor = SENSOR_NAMES.get(name)
+        value = issue.get("sensor_value")
+        unit = issue.get("sensor_unit")
+        measured = (f" ({value:.2f} {unit})" if isinstance(value, (int, float))
+                    and not isinstance(value, bool) and math.isfinite(value) and
+                    isinstance(unit, str) and len(unit) <= 8 else "")
+        message = (f"{sensor} is critical{measured}. Please check the water."
+                   if sensor else "A water sensor is critical. Check the VERDE app.")
+    elif issue_key.startswith("sensor:") and issue_key.endswith(":status"):
         name = issue_key.split(":", 2)[1]
         sensor = SENSOR_NAMES.get(name)
         message = (f"{sensor} sensor is not working. Please check its connection."
                    if sensor else "A sensor is not working. Please check the VERDE app.")
     else:
         message = MESSAGES.get(issue_key, "A system problem needs attention. Please check the VERDE app.")
-    return "VERDE alert: " + message
+    prefix = "VERDE notice: " if slot and slot.group(2) == "harvest_ready" or issue_key == "vision:harvest_ready" else "VERDE alert: "
+    return prefix + message
