[Unit]
Description=VERDE frontend fallback server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=verde
WorkingDirectory=/home/verde/VERDEapp
ExecStart=/usr/bin/python3 -m http.server 8000 --bind 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
