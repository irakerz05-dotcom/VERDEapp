+    def _sms_confirmation(self, modem, timeout_seconds=60):
+        """Read through echoed text until the modem confirms or rejects SMS."""
+        deadline = time.monotonic() + timeout_seconds
+        parts = []
+        while True:
+            chunk = modem.read_all().decode("utf-8", errors="replace")
+            if chunk:
+                parts.append(chunk)
+            response = "".join(parts)
+            if re.search(r"\+CMGS:\s*\d+", response) and re.search(r"(?:^|\r|\n)OK(?:\r|\n|$)", response):
+                return response
+            error = re.search(r"\+CMS ERROR:\s*\d+|(?:^|\r|\n)ERROR(?:\r|\n|$)", response)
+            if error:
+                raise RuntimeError(f"SIM800 rejected SMS: {error.group(0).strip()}")
+            if time.monotonic() >= deadline:
+                raise SMSConfirmationUnknown(
+                    "SMS confirmation did not arrive within 60 seconds; delivery is unknown")
+            self._sleep(0.25)
+
